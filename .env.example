# Web startup reads the project .env as plain data. Existing shell variables win.
# Copy to .env locally, fill only your own credentials, then restart run.cmd.
# Never commit or paste actual secrets. Other data-ingestion CLI commands still use shell variables.
THE_GRAPH_API_KEY=
UNISWAP_SUBGRAPH_ID=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
COINGECKO_API_KEY=
FRED_API_KEY=
# Public endpoint is used by default. Optional replacement must support read-only Ethereum JSON-RPC.
ETHEREUM_RPC_URL=
# Public Arbitrum endpoint is used by default.
ARBITRUM_RPC_URL=
# Optional: disable public market/news polling before launching (1 by default).
# UNISWAP_LIVE_ENABLED=0
# UNISWAP_NEWS_ENABLED=0
# Authenticated read-only news APIs. No requests are made without required credentials.
X_BEARER_TOKEN=
X_POLL_SECONDS=300
X_MAX_RESULTS=10
# Process-memory request cap; resets on restart. Set billing limits in X Console too.
X_MAX_REQUESTS_PER_DAY=100

# Use either an approved OAuth access token OR client ID+secret (optional refresh token).
REDDIT_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
# Replace with your real Reddit username when configuring approved access.
REDDIT_USER_AGENT=
REDDIT_POLL_SECONDS=60

CRYPTOPANIC_API_TOKEN=
# Must match the API plan actually granted in your CryptoPanic account.
CRYPTOPANIC_PLAN=developer
CRYPTOPANIC_POLL_SECONDS=60
# Optional alternate directory for generated data and run records.
# UNISWAP_STATE_DIR=
