# Set secrets in your local shell; the launcher does not auto-load .env.
# If using .env, load it explicitly in your own environment. Never commit real values.
THE_GRAPH_API_KEY=
UNISWAP_SUBGRAPH_ID=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
COINGECKO_API_KEY=
FRED_API_KEY=
# Public endpoint is used by default. Optional replacement must support read-only Ethereum JSON-RPC.
ETHEREUM_RPC_URL=
# Public Arbitrum endpoint is used by default.
ARBITRUM_RPC_URL=
# Optional: disable public market/news polling before launching (1 by default).
# UNISWAP_LIVE_ENABLED=0
# UNISWAP_NEWS_ENABLED=0
# X/Reddit/CryptoPanic APIs are not connected; no keys for those are read.
# Optional alternate directory for generated data and run records.
# UNISWAP_STATE_DIR=
